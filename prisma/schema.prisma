generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cadastro_funcionario {
  id         Int    @id @default(autoincrement())
  nome       String
  cpf        String
  turno      String
  alojamento String
}

model cadastro_alojamento {
  id         Int    @id @default(autoincrement())
  alojamento String
  cep        String
  rua        String
  bairro     String
  numero     Int
  capacidade Int?
  latitude   Float?
  longitude  Float?
}

model usuario {
  id         Int      @id @default(autoincrement())
  nome       String
  email      String   @unique(map: "email")
  password   String
  sexo       String
  dataCriada DateTime @db.DateTime(0)
}

model cadastro_veiculo {
  id      Int    @id @default(autoincrement())
  placa   String
  garagem String
  marca   String
  ano     Int
  tipo    String
}

model cadastro_destino {
  id        Int    @id @default(autoincrement())
  destino   String
  rua       String
  bairro    String
  numero    Int
  cep       String
  latitude  Float?
  longitude Float?
}

model cadastro_garagem {
  id        Int    @id @default(autoincrement())
  garagem   String
  rua       String
  bairro    String
  numero    Int
  cep       String
  latitude  Float?
  longitude Float?
}

model cadastro_servico {
  id         Int      @id @default(autoincrement())
  servico    String
  destino    String
  dataInicio DateTime @db.DateTime(0)
  dataFim    DateTime @db.DateTime(0)
}
