// /prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cadastro_funcionario {
  id         Int    @id @default(autoincrement())
  nome       String
  cpf        String
  turno      String
  
  // Relação com Alojamento
  alojamentoId Int?
  alojamento   cadastro_alojamento? @relation(fields: [alojamentoId], references: [id])

  servicos   servico_funcionario[]
}


model cadastro_alojamento {
  id         Int      @id @default(autoincrement())
  alojamento String
  cep        String
  rua        String
  bairro     String
  numero     Int
  capacidade Int?
  latitude   Float? // Essencial para o mapa
  longitude  Float? // Essencial para o mapa

  funcionarios cadastro_funcionario[] // Relação: Um alojamento pode ter vários funcionários
}

model usuario {
  id         Int      @id @default(autoincrement())
  nome       String
  email      String   @unique
  password   String
  sexo       String
  dataCriada DateTime
}

model cadastro_veiculo {
  id      Int    @id @default(autoincrement())
  placa   String
  garagem String
  marca   String
  ano     Int
  tipo    String
}

model cadastro_destino {
  id        Int      @id @default(autoincrement())
  destino   String
  rua       String
  bairro    String
  cidade    String
  estado    String
  numero    Int
  cep       String
  latitude  Float // Essencial para o mapa
  longitude Float // Essencial para o mapa

  servicos cadastro_servico[] // Relação: Um destino pode ter vários serviços
}


model cadastro_garagem {
  id      Int      @id @default(autoincrement())
  garagem String
  rua     String
  bairro  String
  numero  Int
  cep     String
  latitude  Float? // Essencial para o mapa
  longitude Float? // Essencial para o mapa

  servicos cadastro_servico[] // Relação: Uma garagem pode ter vários serviços
}

model cadastro_servico {
  id         Int      @id @default(autoincrement())
  servico    String
  dataInicio DateTime
  dataFim    DateTime

  // Relação com Destino
  destinoId Int
  destino   cadastro_destino @relation(fields: [destinoId], references: [id])

  // Relação com Garagem
  garagemId Int
  garagem   cadastro_garagem @relation(fields: [garagemId], references: [id])

  funcionarios servico_funcionario[]
}


model servico_funcionario {
  id            Int      @id @default(autoincrement())
  servicoId     Int
  funcionarioId Int
  servico       cadastro_servico     @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  funcionario   cadastro_funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([servicoId, funcionarioId]) // Evita duplicatas
}
